#!/bin/bash
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y git nginx curl ec2-instance-connect
fallocate -l 2G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource.sh
bash /tmp/nodesource.sh
apt-get install -y nodejs
# Descargar el proyecto desde la rama por defecto del repositorio Git.
git clone https://github.com/GBAC22/control-asistencia-frontend.git /opt/frontend
cd /opt/frontend
npm ci
npm run build
cp -r dist/control-asistencia-web/browser/. /var/www/html/
cat > /etc/nginx/sites-available/default <<'NGX'
server {
  listen 80 default_server;
  root /var/www/html;
  index index.html;
  client_max_body_size 12m;
  location /api/ {
    proxy_pass http://${backend_ip}:8000;
    proxy_set_header Host ${backend_ip};
    proxy_set_header X-Real-IP $remote_addr;
    # CloudFront redirige al visitante a HTTPS. El origen recibe HTTP.
    # No confiar en el X-Forwarded-Proto arbitrario del visitante.
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
  }
  location / {
    try_files $uri $uri/ /index.html;
  }
}
NGX
nginx -t
systemctl enable nginx
systemctl restart nginx
touch /var/lib/asistencia-ready
